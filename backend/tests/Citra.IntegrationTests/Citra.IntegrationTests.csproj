<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Integration tests: run against a real, throwaway PostgreSQL + pgvector started in Docker
    by Testcontainers (Docker Desktop must be running). Never touches the development database.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="xunit.runner.visualstudio">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Testcontainers.PostgreSql" />
    <PackageReference Include="Shouldly" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Json" />
    <PackageReference Include="Microsoft.Extensions.TimeProvider.Testing" />
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" />
    <PackageReference Include="Microsoft.AspNetCore.SignalR.Client" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Citra.Infrastructure\Citra.Infrastructure.csproj" />
    <ProjectReference Include="..\..\src\Citra.Worker\Citra.Worker.csproj" />
    <ProjectReference Include="..\..\src\Citra.Api\Citra.Api.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Shouldly" />
    <Using Include="Xunit" />
  </ItemGroup>

  <!--
    Testcontainers' Docker.DotNet.Enhanced.* packages each ship a Microsoft.Net.Http.Client.dll. The NPipe, Unix and
    X509 ones are identical; the LegacyHttp one differs and cannot be loaded here. Which copy lands in bin depends on
    copy order, so a clean build (e.g. a fresh clone) could get the wrong one and fail to reach Docker
    (BadImageFormatException "Index not found"). Never copy the LegacyHttp one.
  -->
  <Target Name="SkipConflictingDockerHttpClient" AfterTargets="ResolvePackageAssets">
    <ItemGroup>
      <_ConflictingDockerHttpClient Include="@(RuntimeCopyLocalItems)"
        Condition="'%(RuntimeCopyLocalItems.NuGetPackageId)' == 'Docker.DotNet.Enhanced.LegacyHttp' And '%(RuntimeCopyLocalItems.Filename)' == 'Microsoft.Net.Http.Client'" />
      <RuntimeCopyLocalItems Remove="@(_ConflictingDockerHttpClient)" />
    </ItemGroup>
  </Target>

</Project>
