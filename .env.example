# Copy to .env (never committed) and fill in. Used by docker-compose.yml.

# Database password (any long random text).
POSTGRES_PASSWORD=

# Signs login tokens: at least 32 random characters, e.g.  openssl rand -base64 48
JWT_SIGNING_KEY=

# Voyage AI key: needed to index documents and search them (free tier is enough for the demo).
VOYAGE_API_KEY=

# Answers: "Extractive" (free stand-in, quotes the documents) or "Anthropic" (needs ANTHROPIC_API_KEY).
CHAT_PROVIDER=Extractive
ANTHROPIC_API_KEY=

# Whether new companies may sign up. On a public showcase server: register your own account and seed the demo
# first, then set false and restart (visitors use "Try the demo"; existing accounts keep logging in).
REGISTRATION_ENABLED=true

# Company whose bots the "Try the demo" button opens (demo-data/seed.py creates "northwind-outdoor"); empty = off.
DEMO_TENANT_SLUG=

# Port on this machine for the app (docker-compose.yml alone, without HTTPS).
CITRA_PORT=8080

# Server only (docker-compose.prod.yml): the address the HTTPS certificate is for, e.g. citra-demo.germanywestcentral.cloudapp.azure.com
CITRA_DOMAIN=
